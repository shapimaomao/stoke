rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /trades/{tradeId} {
      allow read, write: if request.auth != null;
    }
    match /gridConfigs/{configId} {
      allow read, write: if request.auth != null;
    }
    match /strategies/{strategyId} {
      allow read, write: if request.auth != null;
    }
    match /settings/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
